{
  "name": "aetheric-jyotish",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": "22.x"
  },
  "prisma": {
    "schema": "server/prisma/schema.prisma"
  },
  "scripts": {
    "dev": "vite",
    "dev:server": "npm --prefix server run dev",
    "build": "vite build && node scripts/prerender.mjs && node scripts/audit-seo.mjs",
    "vercel-build": "prisma generate && vite build && node scripts/prerender.mjs && node scripts/audit-seo.mjs",
    "postinstall": "prisma generate",
    "preview": "vite preview",
    "test": "node --test src/components/chart/chartValidation.test.js \"tests/unit/*.test.mjs\"",
    "og": "node scripts/og-images.mjs",
    "audit:seo": "node scripts/audit-seo.mjs",
    "indexnow": "node scripts/indexnow.mjs",
    "test:unit": "node --test src/components/chart/chartValidation.test.js \"tests/unit/*.test.mjs\"",
    "test:server": "npm --prefix server test",
    "test:api": "node --test --test-concurrency=1 \"tests/api/*.test.mjs\"",
    "test:e2e": "node --test --test-concurrency=1 \"tests/e2e/*.test.mjs\"",
    "test:perf": "node --test --test-concurrency=1 \"tests/perf/*.test.mjs\"",
    "test:all": "npm run test:unit && npm run test:server && npm run build && npm run test:perf && npm run test:api && npm run test:e2e"
  },
  "dependencies": {
    "@hugeicons/core-free-icons": "^4.3.5",
    "@hugeicons/react": "^1.1.10",
    "@prisma/client": "^5.22.0",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.0",
    "jsonwebtoken": "^9.0.2",
    "motion": "^14.3.0",
    "prisma": "^5.22.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "swisseph-wasm": "^0.1.0",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.5.6",
    "axe-core": "^4.14.0",
    "playwright-core": "^1.64.1",
    "postcss": "^8.5.28",
    "tailwindcss": "^3.4.19",
    "vite": "^5.4.2"
  }
}

# Environment variables for Jyotishly
# Local dev: copy to server/.env. Vercel: set these in Project → Settings → Environment Variables.

# Database (Neon Postgres)
# DATABASE_URL → pooled connection string (host contains "-pooler"), used at runtime
# DIRECT_URL   → direct (non-pooled) connection string, used by Prisma migrations
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require&pgbouncer=true&connect_timeout=15"
DIRECT_URL="postgresql://USER:PASSWORD@ep-xxxx.REGION.aws.neon.tech/neondb?sslmode=require"

# Server Authentication & Security
JWT_SECRET="generate-a-long-random-string"   # required in production
JWT_EXPIRES_IN="7d"
# Guest sessions let visitors make a Kundli without an account (they still cannot chat). Set to "false" to turn them off.
ALLOW_GUEST=true
# No payment gateway yet. Set to "true" only in development to credit tokens/plans without paying.
ALLOW_TEST_PURCHASES=false
NODE_ENV=development
# Optional comma-separated CORS allow-list; leave empty to allow any origin
CORS_ORIGINS="https://your-app.vercel.app"
PORT=3001   # local only, ignored on Vercel

# AI LLM Provider Configuration
GEMINI_API_KEY="your_gemini_api_key_here"
GEMINI_MODEL=gemini-3.6-flash

# Astrology Calculation Engine
FREEASTROAPI_API_KEY="your_freeastroapi_key_here"
FREEASTROAPI_BASE_URL="https://api.freeastroapi.com"
FREEASTROAPI_AYANAMSA=lahiri
VEDASTRO_API_KEY=FreeAPIUser
VEDASTRO_AYANAMSA=LAHIRI

# Google sign-in (optional). Create an OAuth client ID of type "Web application" in
# Google Cloud Console > APIs & Services > Credentials, add your site (and
# http://localhost:5173 for development) under Authorised JavaScript origins.
# The server verifies sign-ins with GOOGLE_CLIENT_ID; the browser shows the button
# when VITE_GOOGLE_CLIENT_ID is set (same value). Leave empty to hide the button.
GOOGLE_CLIENT_ID=""
VITE_GOOGLE_CLIENT_ID=""

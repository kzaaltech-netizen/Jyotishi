{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "installCommand": "npm ci --include=dev",
  "buildCommand": "npm run vercel-build",
  "outputDirectory": "dist",
  "functions": {
    "api/index.js": {
      "maxDuration": 60,
      "includeFiles": "{node_modules/swisseph-wasm/wasm/**,node_modules/.prisma/client/**}"
    }
  },
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "/api"
    },
    {
      "source": "/learn",
      "destination": "/learn/index.html"
    },
    {
      "source": "/learn/:slug",
      "destination": "/learn/:slug/index.html"
    },
    {
      "source": "/:lang(hi|mr|bn|ta|te)",
      "destination": "/:lang/index.html"
    },
    {
      "source": "/:lang(hi|mr|bn|ta|te)/learn",
      "destination": "/:lang/learn/index.html"
    },
    {
      "source": "/:lang(hi|mr|bn|ta|te)/learn/:slug",
      "destination": "/:lang/learn/:slug/index.html"
    },
    {
      "source": "/:page(about|contact|privacy|terms)",
      "destination": "/:page/index.html"
    },
    {
      "source": "/chat",
      "destination": "/app.html"
    },
    {
      "source": "/kundli",
      "destination": "/app.html"
    },
    {
      "source": "/today",
      "destination": "/app.html"
    },
    {
      "source": "/readings",
      "destination": "/app.html"
    },
    {
      "source": "/wallet",
      "destination": "/app.html"
    },
    {
      "source": "/wallet/buy",
      "destination": "/app.html"
    },
    {
      "source": "/pro",
      "destination": "/app.html"
    },
    {
      "source": "/profile",
      "destination": "/app.html"
    },
    {
      "source": "/settings",
      "destination": "/app.html"
    },
    {
      "source": "/login",
      "destination": "/app.html"
    },
    {
      "source": "/start",
      "destination": "/app.html"
    }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(self), geolocation=(self)"
        }
      ]
    },
    {
      "source": "/api/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store"
        }
      ]
    }
  ],
  "trailingSlash": false
}
